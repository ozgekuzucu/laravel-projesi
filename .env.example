APP_NAME="KütüphaneApp"
APP_ENV=local
APP_KEY=base64:BURAYA_PHP_ARTISAN_KEY_GENERATE_CIKTISI_GELECEK
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------------
# Hafta 5: Veritabanı bağlantısı (.env dosyası)
# -------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kutuphane_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file

# -------------------------------------------------------
# Hafta 10: Session ayarları
# -------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync
MAIL_MAILER=smtp
